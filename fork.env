# Identity of the AIUsageBar fork. Read by Scripts/package_app.sh and Scripts/release_fork.sh.
# Keep FORK_BUNDLE_ID in sync with Sources/CodexBarCore/AppBrand.swift.
FORK_APP_NAME=AIUsageBar
FORK_BUNDLE_ID=com.bonsai.aiusagebar
FORK_REPO=Freezind/CodexBar
# Team ID is public (it is embedded in every signed app); set it once the Developer ID certificate exists.
FORK_TEAM_ID=
# Matched against `security find-identity -p codesigning -v`; must select exactly one certificate.
FORK_APP_IDENTITY="Developer ID Application"
# Name of the `xcrun notarytool store-credentials` keychain profile. The credentials stay in the Keychain.
FORK_NOTARY_PROFILE=aiusagebar-notary
FORK_COPYRIGHT="Powered by Bonsai. Based on CodexBar © 2026 Peter Steinberger. MIT License."
